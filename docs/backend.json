{
  "entities": {
    "Contract": {
      "title": "Contract",
      "type": "object",
      "description": "Represents a contract for driving school services.",
      "properties": {
        "id": { "type": "string" },
        "folioNumber": { "type": "number" },
        "title": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string", "format": "email" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["Curso Auto", "Curso Moto", "Curso Mixto", "Curso Deluxe", "Ampliaciones", "Curso Solo Practica"] },
        "status": { "type": "string", "enum": ["draft", "active", "completed", "expired"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "clauses": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "certificateGeneratedAt": { "type": "string", "format": "date-time" },
        "certificateFolio": { "type": "string" }
      },
      "required": ["id", "folioNumber", "title", "clientName", "clientId", "type", "status", "userId", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User role and presence tracking.",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" }
      }
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "type": "object",
      "description": "A conversation between two users.",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantRoles": { "type": "object" },
        "participantNames": { "type": "object" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "structure": [
      {
        "path": "/contracts/{contractId}",
        "definition": {
          "schema": { "$ref": "#/entities/Contract" },
          "description": "Colección raíz unificada para acceso global de la empresa."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": { "$ref": "#/entities/UserProfile" },
          "description": "Perfiles de usuario con sus respectivos roles."
        }
      },
      {
        "path": "/chatRooms/{roomId}",
        "definition": {
          "schema": { "$ref": "#/entities/ChatRoom" },
          "description": "Salas de chat entre personal."
        }
      }
    ]
  }
}