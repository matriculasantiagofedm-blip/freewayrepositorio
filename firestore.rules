
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Function to check if the user has the 'Administrador' role based on custom claims.
    function isAdmin() {
      // This will be true if the user has a custom claim 'role' set to 'Administrador'
      return request.auth.token.role == 'Administrador';
    }
    
    function isVentas() {
        return request.auth.token.role == 'Ventas';
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to the central contracts collection.
     * @path /contracts/{contractId}
     * @allow (get, list) Any signed-in user can view contract details and lists.
     * @allow (create) Any signed-in user can create a contract, but the `userId` must match their own UID.
     * @allow (update) Any signed-in user can update, but key fields `userId` and `folioNumber` are immutable.
     * @allow (delete) Admin/Ventas can delete.
     */
    match /contracts/{contractId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId) || isAdmin() || isVentas();
      allow update: if isSignedIn()
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.folioNumber == resource.data.folioNumber;
      allow delete: if isAdmin() || isVentas();
    }

    /**
     * @description Manages client data.
     * @path /clients/{clientId}
     * @allow (get, list) Any signed-in user can view client lists and details.
     * @allow (create, update) Any signed-in user can create or update a client.
     */
    match /clients/{clientId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false; // Prevent client deletion
    }

    // Allow authenticated users (including Admin/Ventas) to read/write 
    // the specific contract_folio counter for transactional increments on the client.
    match /counters/contract_folio {
        allow read, write: if isAdmin() || isVentas() || isSignedIn();
    }
    
    // Prevent access to any other documents in the counters collection.
    match /counters/{counterId} {
        allow read, write: if false;
    }
  }
}
