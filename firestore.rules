rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // REGLAS DE CANALES POR ROL
    match /chatChannels/{channelId} {
      allow read: if isSignedIn() && getUserRole() in resource.data.allowedRoles;
      allow create, update: if isSignedIn();
    }

    match /chatChannels/{channelId}/messages/{messageId} {
      allow read: if isSignedIn() && getUserRole() in get(/databases/$(database)/documents/chatChannels/$(channelId)).data.allowedRoles;
      allow create: if isSignedIn() && getUserRole() in get(/databases/$(database)/documents/chatChannels/$(channelId)).data.allowedRoles;
    }

    match /chatRooms/{roomId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && 
        request.auth.uid in request.resource.data.participants &&
        !(
          (request.resource.data.participantRoles[request.resource.data.participants[0]] == 'Ventas' && 
           request.resource.data.participantRoles[request.resource.data.participants[1]] == 'Ventas Externas') ||
          (request.resource.data.participantRoles[request.resource.data.participants[0]] == 'Ventas Externas' && 
           request.resource.data.participantRoles[request.resource.data.participants[1]] == 'Ventas')
        );
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
      allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
    }

    match /contracts/{contractId} {
      allow create: if isSignedIn();
      allow read, write: if isSignedIn();
    }

    match /clients/{clientId} {
      allow create: if isSignedIn();
      allow read, write: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    match /{collectionName}/{docId} {
      allow read, write: if isSignedIn();
    }

    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}