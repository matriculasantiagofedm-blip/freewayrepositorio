
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Function to check if the user has the 'Administrador' role based on custom claims.
    function isAdmin() {
      // This will be true if the user has a custom claim 'role' set to 'Administrador'
      return request.auth.token.role == 'Administrador';
    }
    
    function isVentas() {
        return request.auth.token.role == 'Ventas';
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to the central contracts collection.
     * @path /contracts/{contractId}
     * @allow (create) Any signed-in user can create a contract, but the `userId` must match their own UID.
     * @allow (get, list) A user can only read contracts they own. Admins can read all contracts.
     * @allow (update) A user can only update a contract they own, and the `userId` and `folioNumber` cannot be changed.
     * @principle Centralized collection with user-based ownership enforced by rules.
     */
    match /contracts/{contractId} {
      allow get, list: if isAdmin() || isVentas(); // <-- ROL AÑADIDO
      allow create: if isOwner(request.resource.data.userId);
      allow update: if (isAdmin() || (isVentas() && resource.data.userId == request.auth.uid)) && request.resource.data.userId == resource.data.userId && request.resource.data.folioNumber == resource.data.folioNumber;
      allow delete: if isAdmin() || (isVentas() && resource.data.userId == request.auth.uid);
    }

    match /clients/{clientId} {
      allow get, list: if isAdmin() || isVentas(); // <-- ROL AÑADIDO Y SIMPLIFICADO
      // A user can create a client, but they must set themselves as the owner.
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin() || (isVentas() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // Allow authenticated users to read/write the specific contract_folio counter
    // for transactional increments on the client.
    match /counters/contract_folio {
        allow read, write: if isSignedIn();
    }
    
    // Prevent access to any other documents in the counters collection.
    match /counters/{counterId} {
        allow read, write: if false;
    }
  }
}
