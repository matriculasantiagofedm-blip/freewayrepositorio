/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model where each
 * authenticated user is treated as a "client". All data, including contracts,
 * meetings, and reminders, is stored in a private data tree under a document
 * corresponding to the user's unique ID. Users can only access and manage their own
 * data, ensuring strong data isolation between users.
 *
 * Data Structure: Data is organized hierarchically to enforce ownership naturally
 * through Firestore paths.
 * - /clients/{userId}: A document representing the user (client) themselves.
 * - /clients/{userId}/contracts/{contractId}: A subcollection for all contracts
 *   belonging to that user.
 * - /clients/{userId}/contracts/{contractId}/meetings/{meetingId}: A subcollection
 *   for meetings related to a specific contract.
 * - /clients/{userId}/contracts/{contractId}/reminders/{reminderId}: A subcollection
 *   for reminders related to a specific contract.
 *
 * Key Security Decisions:
 * - User Isolation: A user has zero visibility into or access to another user's
 *   data. Listing the top-level `/clients` collection is prohibited.
 * - Path-Based Security: All security rules derive their authority from the `{userId}`
 *   wildcard in the document path, making authorization checks simple and efficient.
 * - Ownership Integrity: On creation, documents must contain an internal ID field
 *   (e.g., 'id' or 'clientId') that matches the user ID in the path, ensuring
 *   data consistency. These ownership fields are immutable once set.
 * - Default Deny: All operations are denied by default unless explicitly granted
 *   by a rule.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the currently authenticated user's ID matches the
     * provided userId, establishing document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * A stricter ownership check for update/delete operations, ensuring the
     * document exists before allowing the operation to proceed.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * Checks if a client with the same idNumber already exists in the database.
     * This is used to prevent creating duplicate clients.
     */
    function isClientDataUnique() {
        let idNumber = request.resource.data.idNumber;
        // Only check for uniqueness if an idNumber is provided and is not an empty string.
        if (idNumber != null && idNumber != "") {
            // Check if any document in the 'clients' collection has the same idNumber.
            // Note: This query is limited to the first 10 documents for performance. 
            // A more robust solution might require a Cloud Function for uniqueness at scale.
            return get(/databases/$(database)/documents/clients?orderBy="idNumber"&equalTo=idNumber).size() == 0;
        }
        // If no idNumber is provided, we don't block the creation.
        return true;
    }

    // --- Create Validation Functions ---

    /**
     * Validates that a new client document contains an 'id' field that
     * matches the document's path ID, and that the client data is unique.
     */
    function hasValidClientDataOnCreate(clientId) {
      return request.resource.data.id == clientId && isClientDataUnique();
    }

    /**
     * Validates that a new contract document contains a 'clientId' field that
     * matches the parent document's path ID.
     */
    function hasValidContractDataOnCreate(clientId) {
      return request.resource.data.clientId == clientId;
    }

    /**
     * Validates that a new meeting document contains a 'contractId' field that
     * matches the parent document's path ID.
     */
    function hasValidMeetingDataOnCreate(contractId) {
      return request.resource.data.contractId == contractId;
    }

    /**
     * Validates that a new reminder document contains a 'contractId' field that
     * matches the parent document's path ID.
     */
    function hasValidReminderDataOnCreate(contractId) {
      return request.resource.data.contractId == contractId;
    }
    
    // --- Update Validation Functions ---

    /**
     * Enforces that the client's unique identifier ('id') cannot be changed
     * after the document has been created.
     */
    function isClientIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Enforces that a contract's parent client ID cannot be changed.
     */
    function isContractClientImmutable() {
      return request.resource.data.clientId == resource.data.clientId;
    }

    /**
     * Enforces that a meeting's parent contract ID cannot be changed.
     */
    function isMeetingContractImmutable() {
      return request.resource.data.contractId == resource.data.contractId;
    }

    /**
     * Enforces that a reminder's parent contract ID cannot be changed.
     */
    function isReminderContractImmutable() {
      return request.resource.data.contractId == resource.data.contractId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    /**
     * @description A user's root document. This rule allows a user to create,
     * read, and manage their own client profile document.
     * @path /clients/{clientId}
     * @allow (create) An authenticated user with UID 'user_abc' creating their
     *   own document at `/clients/user_abc`.
     * @deny (get) An authenticated user 'user_abc' trying to read data from
     *   `/clients/user_xyz`.
     * @principle Restricts access to a user's own data tree and allows for
     *   self-creation of the root user document.
     */
    match /clients/{clientId} {
      allow get: if isOwner(clientId);
      allow list: if false;
      allow create: if isOwner(clientId) && hasValidClientDataOnCreate(clientId);
      allow update: if isExistingOwner(clientId) && isClientIdImmutable();
      allow delete: if isExistingOwner(clientId);

      /**
       * @description A contract belonging to a specific client (user).
       * @path /clients/{clientId}/contracts/{contractId}
       * @allow (list) An authenticated user 'user_abc' listing documents from
       *   `/clients/user_abc/contracts`.
       * @deny (create) An authenticated user 'user_abc' trying to create a
       *   contract at `/clients/user_xyz/contracts/contract_123`.
       * @principle Enforces strict ownership based on the parent path, ensuring
       *   users can only manage their own contracts.
       */
      match /contracts/{contractId} {
        allow get: if isOwner(clientId);
        allow list: if isOwner(clientId);
        allow create: if isOwner(clientId) && hasValidContractDataOnCreate(clientId);
        allow update: if isExistingOwner(clientId) && isContractClientImmutable();
        allow delete: if isExistingOwner(clientId);

        /**
         * @description A meeting related to a specific contract.
         * @path /clients/{clientId}/contracts/{contractId}/meetings/{meetingId}
         * @allow (get) Owner 'user_abc' reading a meeting from
         *   `/clients/user_abc/contracts/contract_123/meetings/meeting_456`.
         * @deny (update) Any user trying to modify a meeting in a contract
         *   that does not belong to them.
         * @principle Extends path-based ownership to nested subcollections,
         *   maintaining security throughout the data hierarchy.
         */
        match /meetings/{meetingId} {
          allow get: if isOwner(clientId);
          allow list: if isOwner(clientId);
          allow create: if isOwner(clientId) && hasValidMeetingDataOnCreate(contractId);
          allow update: if isExistingOwner(clientId) && isMeetingContractImmutable();
          allow delete: if isExistingOwner(clientId);
        }

        /**
         * @description A reminder related to a specific contract.
         * @path /clients/{clientId}/contracts/{contractId}/reminders/{reminderId}
         * @allow (delete) Owner 'user_abc' deleting a reminder from
         *   `/clients/user_abc/contracts/contract_123/reminders/reminder_789`.
         * @deny (list) Any user trying to list reminders from a contract
         *   that does not belong to them.
         * @principle Extends path-based ownership to nested subcollections,
         *   maintaining security throughout the data hierarchy.
         */
        match /reminders/{reminderId} {
          allow get: if isOwner(clientId);
          allow list: if isOwner(clientId);
          allow create: if isOwner(clientId) && hasValidReminderDataOnCreate(contractId);
          allow update: if isExistingOwner(clientId) && isReminderContractImmutable();
          allow delete: if isExistingOwner(clientId);
        }
      }
    }
  }
}
