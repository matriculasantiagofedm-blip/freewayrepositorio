
/**
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. All data that is private
 * to a user, such as their contracts, is nested directly under their user ID.
 * This ensures that a user can only ever access their own data subtree.
 *
 * Data Structure:
 * - /users/{userId}: Stores the user's own profile data.
 * - /users/{userId}/contracts/{contractId}: Stores contracts created by and
 *   belonging to the parent user.
 * - /clients/{clientId}: A top-level collection for client information. This
 *   data is readable by all signed-in users to facilitate features like
 *   assigning a client to a contract, but write access is heavily restricted.
 * - /counters/{counterId}: A restricted collection for distributed counters.
 *   Only accessible by backend functions (e.g., Cloud Functions).
 *
 * Key Security Decisions:
 * - User Isolation: The core principle is that a user's data is isolated under
 *   `/users/{userId}`. All rules for these paths check that the authenticated
 *   user's UID matches the `userId` in the path.
 * - No User Listing: Listing documents in the top-level `/users` collection is
 *   explicitly disallowed to protect user privacy.
 * - Denormalization for Authorization: Contract documents contain a `userId`
 *   field. The rules enforce that this field matches the `{userId}` in the path
 *   on creation and that it is immutable on update. This prevents a contract
 *   from being moved between users and makes rules simpler and more performant.
 * - Restricted Shared Data: The `/clients` collection is readable by any
 *   authenticated user, but cannot be updated or deleted. This is a secure

 *   default because the Client entity lacks an ownership field, making it
 *   impossible to safely determine who should be allowed to modify it.
 * - Backend-Only Counters: The `/counters` collection is locked down. No client-
 *   side read or write is allowed, ensuring that sequential IDs can only be
 *   generated by trusted server-side code (Cloud Functions).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's ID matches the provided userId.
     * This is the foundation of the user-ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for update and delete
     * operations to prevent acting on documents that don't exist.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Manages access to a user's own profile document.
     * @path /users/{userId}
     * @allow (create) A signed-in user (uid: 'user123') can create their own document at `/users/user123`.
     * @deny (get) A signed-in user (uid: 'user456') cannot get the document at `/users/user123`.
     * @deny (list) No user can list the documents in the `/users` collection.
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Secures contract documents, ensuring only the owner can manage them.
       * @path /users/{userId}/contracts/{contractId}
       * @allow (create) User 'user123' can create a contract at `/users/user123/contracts/contractABC`.
       * @deny (list) User 'user456' cannot list contracts under `/users/user123`.
       * @principle Enforces document ownership for all operations within a user's private subcollection.
       */
      match /contracts/{contractId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Manages client data. Clients can be read by any authenticated user,
     * but write access is restricted to prevent unauthorized modification of shared data.
     * @path /clients/{clientId}
     * @allow (get) Any signed-in user can get or list clients.
     * @allow (create) Any signed-in user can create a new client document.
     * @deny (update) A user cannot update a client document because there is no ownership model.
     * @principle Provides read access for shared data while preventing modification of data that lacks a clear owner.
     */
    match /clients/{clientId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      // CRITICAL: Cannot implement owner-only writes for update/delete. The 'Client' entity is missing an 'ownerId' or 'authorId' field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Distributed counters for things like invoice numbers.
     * This collection is not readable or writable by clients. It is only
     * accessible by Cloud Functions with elevated privileges.
     * @path /counters/{counterId}
     * @deny (read, write) All client-side access is denied.
     * @principle Prevents clients from tampering with counters.
     */
    match /counters/{counterId} {
        allow read, write: if false;
    }
  }
}
