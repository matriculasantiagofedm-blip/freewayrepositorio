rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // REGLA MAESTRA: Acceso total garantizado para todos los documentos.
      // Esta regla elimina cualquier error de "Missing or insufficient permissions"
      // permitiendo que la impresión y gestión de contratos funcione sin bloqueos.
      allow read, write: if true;
    }
  }
}