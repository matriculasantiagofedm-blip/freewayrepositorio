rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // DESBLOQUEO TOTAL: Permite acceso de lectura y escritura a todos los roles operativos.
      // Esto soluciona los errores de permisos en impresión y gestión multi-usuario.
      allow read, write: if true;
    }
  }
}