
{
  "entities": {
    "Contract": {
      "title": "Contract",
      "type": "object",
      "description": "Represents a contract for driving school services.",
      "properties": {
        "id": { "type": "string" },
        "folioNumber": { "type": "number" },
        "title": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string", "format": "email" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["Curso Auto", "Curso Moto", "Curso Mixto", "Curso Deluxe", "Ampliaciones", "Curso Solo Practica"] },
        "status": { "type": "string", "enum": ["draft", "active", "completed", "expired"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "clauses": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "certificateGeneratedAt": { "type": "string", "format": "date-time" },
        "certificateFolio": { "type": "string" },
        "autoMotoDetails": { "$ref": "#/entities/AutoMotoContractDetails" },
        "deluxeDetails": { "$ref": "#/entities/DeluxeContractDetails" },
        "ampliacionesDetails": { "$ref": "#/entities/AmpliacionesContractDetails" }
      },
      "required": ["id", "folioNumber", "title", "clientName", "clientId", "type", "status", "userId", "createdAt"]
    },
    "ManualSchedule": {
      "title": "Manual Schedule Entry",
      "type": "object",
      "description": "A manual assignment for the weekly schedule.",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "timeSlot": { "type": "string", "enum": ["8am-10am", "10am-12pm", "1pm-3pm", "3pm-5pm"] },
        "vehicle": { "type": "string" },
        "instructor": { "type": "string" },
        "classNumber": { "type": "number" },
        "classType": { "type": "string", "enum": ["Práctica", "Teórica"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentName", "date", "timeSlot", "vehicle", "instructor", "userId"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Represents a client associated with a contract.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "idNumber": { "type": "string" },
        "phone": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "userId"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Represents a financial transaction.",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "contractId": { "type": "string" },
        "contractFolio": { "type": "number" },
        "cancellationFolio": { "type": "number" },
        "updateFolio": { "type": "number" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientAddress": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["abono", "cancelacion", "actualizacion"] },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "amount", "paymentDate", "contractId", "clientId", "userId", "type"]
    },
    "BookSalePayment": {
      "title": "Book Sale Payment",
      "type": "object",
      "description": "Represents a payment for a book sale.",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "bookSaleFolio": { "type": "number" },
        "bookTitle": { "type": "string" },
        "clientName": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "userId": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "amount", "paymentDate", "bookSaleFolio", "bookTitle", "clientName", "userId"]
    },
    "MileageLog": {
      "title": "Mileage Log",
      "type": "object",
      "description": "Represents a daily mileage log for company vehicles.",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "cars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "enum": ["Picanto Blanco", "Picanto Bronce", "Spark", "Moto Roja", "Moto Negra"] },
              "initialMileage": { "type": "number" },
              "finalMileage": { "type": "number" },
              "distance": { "type": "number" }
            },
            "required": ["name", "initialMileage", "finalMileage", "distance"]
          }
        },
        "totalDistance": { "type": "number" }
      },
      "required": ["id", "date", "userId", "cars"]
    },
    "MaintenanceLog": {
      "title": "Maintenance Log",
      "type": "object",
      "description": "Represents a maintenance log for a company vehicle.",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "vehicle": { "type": "string", "enum": ["Picanto Blanco", "Picanto Bronce", "Spark", "Moto Roja", "Moto Negra"] },
        "mileage": { "type": "number" },
        "type": { "type": "string", "enum": ["Cambio de Aceite", "Revisión de Frenos", "Rotación de Llantas", "Mantenimiento General", "Otro"] },
        "description": { "type": "string" },
        "cost": { "type": "number" },
        "nextServiceDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "userId", "vehicle", "mileage", "type", "description", "cost"]
    },
    "AutoMotoContractDetails": {
        "title": "Auto/Moto Contract Details",
        "type": "object",
        "properties": {
            "studentIdNumber": { "type": "string" },
            "studentAddress": { "type": "string" },
            "studentPhone1": { "type": "string" },
            "studentPhone2": { "type": "string" },
            "coursePlan": { "type": "string" },
            "courseValue": { "type": "number" },
            "downPayment": { "type": "number" },
            "balance": { "type": "number" },
            "paymentDeadline": { "type": "string", "format": "date-time" },
            "vehicle": { "type": "string" },
            "vehicleTransmission": { "type": "string" },
            "licenseCategory": { "type": "string" },
            "theoreticalClassSchedule": { "type": "string" },
            "theoreticalClassDates": { "type": "array", "items": { "type": "string", "format": "date-time" } },
            "practicalClassSchedules": { "type": "array", "items": { "type": "object", "properties": { "date": { "type": "string", "format": "date-time" }, "time": { "type": "string" } } } },
            "motoPracticalClassSchedules": { "type": "array", "items": { "type": "object", "properties": { "date": { "type": "string", "format": "date-time" }, "time": { "type": "string" } } } },
            "paidInFull": { "type": "boolean" },
            "paymentType": { "type": "string" },
            "instructor": { "type": "string" }
        }
    },
    "DeluxeContractDetails": {
        "title": "Deluxe Contract Details",
        "type": "object",
        "properties": {
            "studentIdNumber": { "type": "string" },
            "studentAddress": { "type": "string" },
            "studentPhone1": { "type": "string" },
            "studentPhone2": { "type": "string" },
            "paymentDetails": { "type": "string" },
            "paymentAmount": { "type": "number" },
            "paymentInstallments": { "type": "array", "items": { "type": "string", "format": "date-time" } },
            "vehicleTransmission": { "type": "string" },
            "licenseCategory": { "type": "string" },
            "theoreticalClassSchedule": { "type": "string" },
            "theoreticalClasses": { "type": "array", "items": { "type": "string", "format": "date-time" } },
            "classSchedules": { "type": "array", "items": { "type": "object", "properties": { "date": { "type": "string", "format": "date-time" }, "time": { "type": "string" } } } },
            "paymentType": { "type": "string" },
            "instructor": { "type": "string" }
        }
    },
    "AmpliacionesContractDetails": {
        "title": "Ampliaciones Contract Details",
        "type": "object",
        "properties": {
            "studentIdNumber": { "type": "string" },
            "studentAddress": { "type": "string" },
            "studentPhone1": { "type": "string" },
            "studentPhone2": { "type": "string" },
            "courseValue": { "type": "number" },
            "downPayment": { "type": "number" },
            "balance": { "type": "number" },
            "paymentDeadline": { "type": "string", "format": "date-time" },
            "selectedPlans": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "price": { "type": "number" } } } },
            "theoreticalClassDate": { "type": "string", "format": "date-time" },
            "theoreticalClassTime": { "type": "string" },
            "paymentType": { "type": "string" }
        }
    },
    "Counter": {
      "title": "Counter",
      "type": "object",
      "description": "A generic counter document for sequential IDs.",
      "properties": {
        "count": { "type": "number" }
      },
      "required": ["count"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": { "$ref": "#/entities/User" },
          "description": "Stores user profile information."
        }
      },
      {
        "path": "/clients/{clientId}",
        "definition": {
          "schema": { "$ref": "#/entities/Client" },
          "description": "Stores individual client data."
        }
      },
      {
        "path": "/contracts/{contractId}",
        "definition": {
          "schema": { "$ref": "#/entities/Contract" },
          "description": "Stores all contracts in a single collection for easy querying."
        }
      },
      {
        "path": "/manual_schedules/{entryId}",
        "definition": {
          "schema": { "$ref": "#/entities/ManualSchedule" },
          "description": "Stores manual weekly schedule assignments."
        }
      },
      {
        "path": "/cancellation_payments/{paymentId}",
        "definition": {
          "schema": { "$ref": "#/entities/Payment" },
          "description": "Stores cancellation payment transactions."
        }
      },
      {
        "path": "/update_payments/{paymentId}",
        "definition": {
          "schema": { "$ref": "#/entities/Payment" },
          "description": "Stores certificate update payment transactions."
        }
      },
      {
        "path": "/book_sale_payments/{paymentId}",
        "definition": {
          "schema": { "$ref": "#/entities/BookSalePayment" },
          "description": "Stores book sale payment transactions."
        }
      },
       {
        "path": "/mileage_logs/{logId}",
        "definition": {
          "schema": { "$ref": "#/entities/MileageLog" },
          "description": "Stores daily mileage logs for vehicles."
        }
      },
      {
        "path": "/maintenance_logs/{logId}",
        "definition": {
          "schema": { "$ref": "#/entities/MaintenanceLog" },
          "description": "Stores maintenance logs for vehicles."
        }
      },
      {
        "path": "/counters/{counterId}",
        "definition": {
          "schema": { "$ref": "#/entities/Counter" },
          "description": "Stores distributed counters for generating sequential folio numbers."
        }
      }
    ]
  }
}
