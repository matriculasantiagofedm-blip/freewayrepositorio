rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // REGLAS PARA USUARIOS Y PERFILES
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // REGLAS PARA CONTRATOS
    match /contracts/{contractId} {
      allow read, write: if isSignedIn();
    }

    // REGLAS PARA PAGOS, CAJA Y LIBROS
    match /cancellation_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /update_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /book_sale_payments/{id} {
      allow read, write: if isSignedIn();
    }

    // REGLAS PARA AGENDA Y CONTROL FLOTA
    match /manual_schedules/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /mileage_logs/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /maintenance_logs/{id} {
      allow read, write: if isSignedIn();
    }

    // REGLAS PARA CHAT
    match /chatChannels/{channelId} {
      allow read, write: if isSignedIn();
    }

    match /chatChannels/{channelId}/messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // REGLAS PARA CLIENTES Y CONTADORES
    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // REGLA GLOBAL PARA OPERACIONES INTERNAS DE LA ESCUELA
    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}