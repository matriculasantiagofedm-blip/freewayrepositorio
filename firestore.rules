rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // REGLAS PARA OPERACIONES DE CAJA Y REPORTES
    // Permitir acceso total a personal administrativo autenticado
    match /contracts/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /cancellation_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /update_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /book_sale_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /counters/{id} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }

    match /chatChannels/{path=**} {
      allow read, write: if isSignedIn();
    }

    // REGLA GLOBAL DE RESPALDO PARA OPERACIONES INTERNAS
    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}