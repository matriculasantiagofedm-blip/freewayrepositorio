rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Acceso total abierto para eliminar errores de permisos en impresión y gestión de folios.
      // Esta regla permite que todos los roles operativos (Admin, Ventas, Ventas Externas) 
      // puedan leer y escribir documentos sin restricciones de seguridad de Firebase.
      allow read, write: if true;
    }
  }
}