
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /contracts/{contractId} {
      allow read, list, create, update: if isSignedIn();
      allow delete: if false; 
    }

    match /clients/{clientId} {
      allow read, list, create, update: if isSignedIn();
    }

    match /cancellation_payments/{paymentId} {
      allow read, list, create: if isSignedIn();
    }

    match /update_payments/{paymentId} {
      allow read, list, create: if isSignedIn();
    }

    match /book_sale_payments/{paymentId} {
      allow read, list, create: if isSignedIn();
    }
    
    match /mileage_logs/{logId} {
      allow read, list, create, update: if isSignedIn();
    }

    match /maintenance_logs/{logId} {
      allow read, list, create, update: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }
  }
}
