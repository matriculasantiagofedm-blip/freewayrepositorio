rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Acceso total abierto para eliminar errores de permisos en impresión y gestión de documentos.
      // Esta regla permite que todos los usuarios y roles puedan leer y escribir sin restricciones.
      allow read, write: if true;
    }
  }
}