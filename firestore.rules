
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Function to check if the user has the 'Administrador' role based on custom claims.
    function isAdmin() {
      // This will be true if the user has a custom claim 'role' set to 'Administrador'
      return request.auth.token.role == 'Administrador';
    }
    
    function isVentas() {
        return request.auth.token.role == 'Ventas';
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to the central contracts collection.
     * @path /contracts/{contractId}
     * @allow (get, list) Any signed-in user can view contract details and lists.
     * @allow (create) Any signed-in user can create a contract. The userId is set on the server.
     * @allow (update) Any signed-in user can update, but key fields `userId` and `folioNumber` are immutable.
     * @allow (delete) Admin/Ventas can delete.
     */
    match /contracts/{contractId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      // Allow general updates if key fields are unchanged
      allow update: if isSignedIn()
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.folioNumber == resource.data.folioNumber;
      
      // Allow admin to specifically annul a contract
      allow update: if isAdmin()
                      && request.resource.data.status == 'expired';

      allow delete: if isAdmin() || isVentas();
    }

    /**
     * @description Manages client data.
     * @path /clients/{clientId}
     * @allow (get) Signed-in users can view client details for contract creation.
     * @allow (list) Allows querying the collection (e.g., to check for existing clients by ID number).
     * @allow (create, update) Any signed-in user can create or update a client.
     */
    match /clients/{clientId} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if false; // Prevent client deletion
    }

    /**
     * @description Manages payment records. Allows Admins/Ventas to list payments for reports.
     * @path /payments
     */
    match /payments/{document=**} {
      // Rule for listing the collection, required for queries with orderBy/where.
      allow list: if isAdmin() || isVentas();
    }

    /**
     * @description Manages individual payment documents.
     * @path /payments/{paymentId}
     */
    match /payments/{paymentId} {
        // Allows fetching a single document.
        allow get: if isAdmin() || isVentas();
        // Allow any signed-in user to create a payment record (e.g., from the cancellations page).
        allow create: if isSignedIn();
        // Payments are immutable and cannot be updated or deleted.
        allow update, delete: if false;
    }


    // Allow authenticated users to read/write the contract folio counter.
    match /counters/contract_folio {
        allow read, write: if isSignedIn();
    }

    // Allow authenticated users to read/write the cancellation folio counter.
    match /counters/cancellation_folio {
        allow read, write: if isSignedIn();
    }

    // Allow authenticated users to read/write the update folio counter.
    match /counters/update_folio {
        allow read, write: if isSignedIn();
    }
    
    // Prevent access to any other documents in the counters collection.
    match /counters/{counterId} {
        allow read, write: if false;
    }
  }
}
