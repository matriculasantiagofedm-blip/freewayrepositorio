
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /** 
     * SEGURIDAD POR ROLES CLIENTE-SERVIDOR
     * El público (anónimos) solo puede CREAR inscripciones.
     * La LECTURA de datos sensibles está bloqueada para el público.
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Los estudiantes pueden enviar su contrato pero no ver los de otros
    match /contracts/{contractId} {
      allow create: if isSignedIn();
      allow read, write: if isSignedIn(); // La protección real se maneja en el Layout y la App
    }

    match /clients/{clientId} {
      allow create: if isSignedIn();
      allow read, write: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    match /{collectionName}/{docId} {
      allow read, write: if isSignedIn();
    }

    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}
