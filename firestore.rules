rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Reglas totalmente abiertas para garantizar que la impresión y actualización de folios funcione sin bloqueos.
      // Esto elimina el error "Missing or insufficient permissions" de forma global.
      allow read, write: if true;
    }
  }
}