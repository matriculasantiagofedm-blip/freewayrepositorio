{
  "entities": {
    "Contract": {
      "title": "Contract",
      "type": "object",
      "description": "Representa un contrato de servicio de la escuela de manejo con detalles ATTT.",
      "properties": {
        "id": { "type": "string" },
        "folioNumber": { "type": "number" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string", "format": "email" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["Curso Auto", "Curso Moto", "Curso Mixto", "Curso Deluxe", "Ampliaciones", "Curso Solo Practica"] },
        "status": { "type": "string", "enum": ["draft", "active", "completed", "expired"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "certificateGeneratedAt": { "type": "string", "format": "date-time" },
        "certificateFolio": { "type": "string" },
        "paymentReference": { "type": "string" }
      },
      "required": ["id", "folioNumber", "clientName", "type", "status", "userId", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Perfil de usuario para identificación en chat y auditoría.",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" }
      }
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Registro de pagos por cancelaciones, abonos o actualizaciones.",
      "properties": {
        "amount": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "clientName": { "type": "string" },
        "type": { "type": "string", "enum": ["abono", "cancelacion", "actualizacion"] }
      }
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/Contract" },
      "description": "Contratos y expedientes de alumnos."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfiles de personal administrativo."
    },
    "/cancellation_payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Pagos de saldos pendientes."
    },
    "/update_payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Pagos por actualización de certificados."
    },
    "/book_sale_payments/{saleId}": {
      "schema": { "type": "object" },
      "description": "Venta de libros de educación vial."
    },
    "/manual_schedules/{scheduleId}": {
      "schema": { "type": "object" },
      "description": "Asignaciones manuales de agenda práctica."
    },
    "/mileage_logs/{logId}": {
      "schema": { "type": "object" },
      "description": "Control diario de kilometraje de vehículos."
    },
    "/maintenance_logs/{logId}": {
      "schema": { "type": "object" },
      "description": "Historial de mantenimiento de la flota."
    },
    "/clients/{clientId}": {
      "schema": { "type": "object" },
      "description": "Fichas de clientes de la escuela."
    },
    "/counters/{counterId}": {
      "schema": { "type": "object" },
      "description": "Contadores para folios de contratos y pagos."
    }
  }
}