rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /contracts/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /cancellation_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /update_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /book_sale_payments/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /counters/{id} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }

    match /users_crm/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /leads/{leadId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /expenses/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() || request.resource.data.source == 'TimeWise Integration';
    }

    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}
