/**
 * Firestore Security Rules for ContractTime
 *
 * Se ha simplificado el modelo para permitir acceso global a las colecciones raíz
 * por parte de los usuarios autenticados del sistema (Administrador, Ventas, etc.).
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /** Verifica si el usuario ha iniciado sesión en el sistema */
    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * Regla global para prototipado: permite lectura y escritura en todas las 
     * colecciones raíz si el usuario está autenticado.
     */
    match /{collectionName}/{docId} {
      allow read, write: if isSignedIn();
    }

    /** 
     * Soporte para subcolecciones (si existieran en el futuro)
     */
    match /{path=**} {
      allow read, write: if isSignedIn();
    }
  }
}