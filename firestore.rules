rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ACCESO TOTAL - DESBLOQUEO DE PROTOTIPO
     * 
     * Se permite acceso universal de lectura y escritura para que todos los roles 
     * (Administrador, Ventas, Ventas Externas) operen sobre la misma base de datos.
     */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}