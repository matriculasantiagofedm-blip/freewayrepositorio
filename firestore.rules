
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the currently authenticated user's ID matches the
     * provided userId, establishing document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Validates that a new contract document contains a 'userId' field that
     * matches the currently authenticated user.
     */
    function hasValidContractDataOnCreate() {
      return request.resource.data.userId == request.auth.uid;
    }
    
    /**
     * Enforces that a contract's owner ID cannot be changed.
     */
    function isContractOwnerImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    match /clients/{clientId} {
      // Any signed-in user can create a client, as long as they set themselves as owner.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the user who created the client can access or delete it.
      allow read, update, delete: if isOwner(resource.data.userId);
      // Disallow listing all clients for security.
      allow list: if false;
    }
    
    match /contracts/{contractId} {
      // A user can get a contract if they are the owner.
      allow get: if isOwner(resource.data.userId);

      // A user can list contracts ONLY if the query explicitly filters by their own UID.
      // This is the key rule to prevent permission errors on list operations.
      allow list: if isSignedIn() && (request.query.where.find(field => field[0] == 'userId' && field[2] == request.auth.uid) != null);
      
      // A user can create a contract if they are signed in and the new contract's userId is their own.
      allow create: if isSignedIn() && hasValidContractDataOnCreate();
      
      // A user can update or delete a contract only if they are the owner.
      allow update: if isOwner(resource.data.userId) && isContractOwnerImmutable();
      allow delete: if isOwner(resource.data.userId);

      // Subcollection rules now also check ownership on the parent contract.
      match /meetings/{meetingId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/contracts/$(contractId)).data.userId);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/contracts/$(contractId)).data.userId);
      }
    }
  }
}
