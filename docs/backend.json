{
  "entities": {
    "Contract": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Contract",
      "type": "object",
      "description": "Represents a contract between a user and a client.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Contract entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "clientId": {
          "type": "string",
          "description": "Reference to Client."
        },
        "clauses": {
          "type": "string",
          "description": "The clauses and terms defined in the contract."
        },
        "deadline": {
          "type": "string",
          "description": "Deadline for the contract execution. (date-time)",
          "format": "date-time"
        },
        "meetingTime": {
          "type": "string",
          "description": "Scheduled meeting time for the contract. (date-time)",
          "format": "date-time"
        },
        "contractName": {
          "type": "string",
          "description": "The name of the contract."
        },
        "status": {
          "type": "string",
          "description": "The status of the contract (e.g., draft, active, completed, cancelled)."
        }
      },
      "required": [
        "id",
        "userId",
        "clientId",
        "clauses"
      ]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Represents a client.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Client entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the client."
        },
        "email": {
          "type": "string",
          "description": "The email address of the client.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the client."
        },
        "idNumber": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/contracts/{contractId}",
        "definition": {
          "entityName": "Contract",
          "schema": {
            "$ref": "#/backend/entities/Contract"
          },
          "description": "Colección raíz unificada para todos los contratos de la empresa."
        }
      },
      {
        "path": "/clients/{clientId}",
        "definition": {
          "entityName": "Client",
          "schema": {
            "$ref": "#/backend/entities/Client"
          },
          "description": "Stores client data."
        }
      }
    ],
    "reasoning": "Se utiliza una estructura de colección raíz para /contracts para permitir el acceso compartido entre todos los roles operativos de la empresa, facilitando la gestión unificada y reportes globales."
  }
}