/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model where each
 * authenticated user is treated as a "client". All data, including contracts,
 * meetings, and reminders, is stored in a private data tree under a document
 * corresponding to the user's unique ID. Users can only access and manage their own
 * data, ensuring strong data isolation between users.
 *
 * Data Structure: Data is organized hierarchically to enforce ownership naturally
 * through Firestore paths.
 * - /clients/{userId}: A document representing the user (client) themselves.
 * - /contracts/{contractId}: A global collection for all contracts. Each contract
 *   has a `userId` field to link it to its owner.
 * - /contracts/{contractId}/meetings/{meetingId}: A subcollection
 *   for meetings related to a specific contract.
 * - /contracts/{contractId}/reminders/{reminderId}: A subcollection
 *   for reminders related to a specific contract.
 *
 * Key Security Decisions:
 * - User Isolation vs. Admin Access: A user can only access their own data, but
 *   an admin can access all data.
 * - Path-Based Security: All security rules derive their authority from the `{userId}`
 *   wildcard in the document path, making authorization checks simple and efficient.
 * - Ownership Integrity: On creation, documents must contain an internal ID field
 *   (e.g., 'id' or 'clientId') that matches the user ID in the path, ensuring
 *   data consistency. These ownership fields are immutable once set.
 * - Default Deny: All operations are denied by default unless explicitly granted
 *   by a rule.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }
    
    /**
     * Returns true if the user has the 'Administrador' role.
     * This is determined by checking a custom claim on the user's auth token.
     * This claim must be set via a backend process (e.g., Cloud Function).
     */
    function isAdmin() {
      // In a real app, this would check a custom claim:
      // return request.auth.token.admin == true;
      // For this app, we'll check a field in the user's profile document.
      // Note: This creates a dependency on another document read.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador';
    }


    /**
     * Returns true if the currently authenticated user's ID matches the
     * provided userId, establishing document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isDocumentOwner(doc) {
        return request.auth.uid == doc.data.userId;
    }

    /**
     * A stricter ownership check for update/delete operations, ensuring the
     * document exists before allowing the operation to proceed.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * Checks if a client with the same idNumber already exists in the database.
     * This is used to prevent creating duplicate clients.
     */
    function isClientDataUnique() {
        let idNumber = request.resource.data.idNumber;
        if (idNumber != null && idNumber != "") {
            return get(/databases/$(database)/documents/clients?orderBy="idNumber"&equalTo=idNumber).size() == 0;
        }
        return true;
    }

    // --- Create Validation Functions ---

    /**
     * Validates that a new client document contains an 'id' field that
     * matches the document's path ID, and that the client data is unique.
     */
    function hasValidClientDataOnCreate(clientId) {
      return request.resource.data.id == clientId && isClientDataUnique();
    }

    /**
     * Validates that a new contract document contains a 'clientId' field that
     * matches the parent document's path ID.
     */
    function hasValidContractDataOnCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Validates that a new meeting document contains a 'contractId' field that
     * matches the parent document's path ID.
     */
    function hasValidMeetingDataOnCreate(contractId) {
      return request.resource.data.contractId == contractId;
    }

    /**
     * Validates that a new reminder document contains a 'contractId' field that
     * matches the parent document's path ID.
     */
    function hasValidReminderDataOnCreate(contractId) {
      return request.resource.data.contractId == contractId;
    }
    
    // --- Update Validation Functions ---

    /**
     * Enforces that the client's unique identifier ('id') cannot be changed
     * after the document has been created.
     */
    function isClientIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Enforces that a contract's parent client ID cannot be changed.
     */
    function isContractOwnerImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    /**
     * Enforces that a meeting's parent contract ID cannot be changed.
     */
    function isMeetingContractImmutable() {
      return request.resource.data.contractId == resource.data.contractId;
    }

    /**
     * Enforces that a reminder's parent contract ID cannot be changed.
     */
    function isReminderContractImmutable() {
      return request.resource.data.contractId == resource.data.contractId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    match /clients/{clientId} {
      allow read, delete: if isOwner(clientId) || isAdmin();
      allow create: if isOwner(clientId) && hasValidClientDataOnCreate(clientId);
      allow update: if (isOwner(clientId) || isAdmin()) && isClientIdImmutable();
      allow list: if isAdmin();
    }
    
    match /contracts/{contractId} {
        allow get: if isDocumentOwner(resource) || isAdmin();
        allow list: if isSignedIn();
        allow create: if hasValidContractDataOnCreate(request.auth.uid);
        allow update: if (isDocumentOwner(resource) || isAdmin()) && isContractOwnerImmutable();
        allow delete: if isDocumentOwner(resource) || isAdmin();

        match /meetings/{meetingId} {
          allow read, write: if get(/databases/$(database)/documents/contracts/$(contractId)).data.userId == request.auth.uid || isAdmin();
        }

        match /reminders/{reminderId} {
          allow read, write: if get(/databases/$(database)/documents/contracts/$(contractId)).data.userId == request.auth.uid || isAdmin();
        }
      }
    }
  }
