rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Reglas totalmente abiertas para evitar errores de permisos en impresión y desarrollo.
      // Esto permite que tanto la actualización del contrato como la lectura en la pestaña de impresión funcionen sin bloqueos.
      allow read, write: if true;
    }
  }
}