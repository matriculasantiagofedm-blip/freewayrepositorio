rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIREBASE SECURITY RULES - ACCESO TOTAL (PROTOTIPO)
     * 
     * Se ha configurado acceso universal de lectura y escritura para permitir que 
     * todos los roles (Administrador, Ventas, Ventas Externas) colaboren sobre 
     * la misma base de datos sin restricciones de propiedad de documento.
     * Esto soluciona los errores de 'Missing or insufficient permissions'.
     */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}