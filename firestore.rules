rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow list: if false;
    }

    match /contracts/{contractId} {
      allow read, list, create, update: if isSignedIn();
      allow delete: if isSignedIn(); // Permitir anulación lógica vía update o física si es necesario
    }

    match /clients/{clientId} {
      allow read, list, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /cancellation_payments/{paymentId} {
      allow create, read: if isSignedIn();
    }

    match /update_payments/{paymentId} {
      allow create, read: if isSignedIn();
    }

    match /book_sale_payments/{paymentId} {
      allow create, read: if isSignedIn();
    }
    
    match /mileage_logs/{logId} {
      allow read, list, create, update: if isSignedIn();
    }

    match /maintenance_logs/{logId} {
      allow read, list, create, update: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }
  }
}